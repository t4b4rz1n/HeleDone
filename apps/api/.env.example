SECRET_KEY=django-insecure-local-madar-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_CORS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
TRUST_PROXY_PROTO=False
API_PUBLIC_URL=/
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_AGE=31536000
CSRF_COOKIE_SECURE=False
# Local HTTP development only. Keep this True for HTTPS deployments.
AUTH_COOKIE_SECURE=False

USE_SQLITE=False
DB_NAME=madar_db
DB_USER=madar_user
DB_PASSWORD=madar_password
DB_HOST=madar_db
DB_PORT=5432

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=adminpass123

USE_MINIO=True
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password
AWS_STORAGE_BUCKET_NAME=madar-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_MINAIO_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False
AWS_QUERYSTRING_AUTH=True
AWS_S3_CUSTOM_DOMAIN=localhost:9000/madar-media
AWS_S3_URL_PROTOCOL=http:
AWS_DEFAULT_ACL=private
AWS_S3_OBJECT_PARAMETERS={"CacheControl": "max-age=86400"}

TICKET_ATTACHMENT_MAX_FILE_SIZE=104857600
TICKET_ATTACHMENT_MAX_FILES=5
TICKET_ATTACHMENT_BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.sh

JWT_ACCESS_LIFETIME_DAYS=365
JWT_REFRESH_LIFETIME_DAYS=730

SANDBOX=True
NOWPAYMENTS_API_KEY=nowpayments-api-key
NOWPAYMENTS_SANDBOX_API_KEY=nowpayments-sandbox-api-key
ZARINPAL_MERCHANT_ID=zarinpal-merchant-id
CALLBACK_URL=http://localhost:3000/payment/verify/
CANCEL_URL=http://localhost:3000/payment/cancel/

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Madaar <noreply@madaar.io>

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=

ENABLE_FIELD_FILTER_PAGINATION=False
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Rate Throttling (requests per time window)
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_USER=300/minute
